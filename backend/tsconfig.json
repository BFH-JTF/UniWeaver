{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@uniweaver/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../packages/shared/src/**/*.ts"]
}