# ── Application ─────────────────────────────────────────────
APP_TITLE=UniWeaver
BOOTSTRAP_ADMIN_SECRET=change-me-in-production
SESSION_SECRET=change-me-a-long-random-string-at-least-32-chars

# ── Backend server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uniweaver
POSTGRES_USER=uniweaver
POSTGRES_PASSWORD=uniweaver

# ── OIDC identity provider ──────────────────────────────────
# Any standard OIDC provider (docPouch, EduID, Keycloak, …).
# OIDC_ISSUER is the browser-facing issuer URL. With the bundled docPouch
# setup, the provider is reverse-proxied same-origin at /oidc, so the issuer
# is "<UniWeaver origin>/oidc" and docPouch advertises that same value via
# env_file. OIDC_INTERNAL_ISSUER is the upstream URL the backend uses for
# discovery, JWKS, and proxying (docker-internal hostname).
OIDC_ISSUER=http://localhost:3000/oidc
OIDC_INTERNAL_ISSUER=http://doc-pouch:3030/oidc
# Optional: pin the aud claim to a pre-registered client id. Leave empty when
# the SPA self-registers its client via dynamic registration (default).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=docPouch
# URLs of the four frontends used for OIDC redirects (dev defaults shown)
USER_ENTRY_URL=http://localhost:5173
ADMINISTRATION_URL=http://localhost:5174
SCHEDULING_URL=http://localhost:5175
COMPETENCIES_URL=http://localhost:5176